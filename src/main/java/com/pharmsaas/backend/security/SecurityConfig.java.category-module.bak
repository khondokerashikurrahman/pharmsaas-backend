
        package com.pharmsaas.backend.security;

import jakarta.servlet.DispatcherType;

import java.util.List;

import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.http.HttpMethod;
import org.springframework.security.config.Customizer;
import org.springframework.security.config.annotation.web.builders.HttpSecurity;
import org.springframework.security.config.http.SessionCreationPolicy;
import org.springframework.security.web.SecurityFilterChain;
import org.springframework.security.web.authentication.UsernamePasswordAuthenticationFilter;
import org.springframework.web.cors.CorsConfiguration;
import org.springframework.web.cors.CorsConfigurationSource;
import org.springframework.web.cors.UrlBasedCorsConfigurationSource;

@Configuration
public class SecurityConfig {

    private final JwtAuthenticationFilter jwtAuthenticationFilter;
    private final JwtAuthenticationEntryPoint authenticationEntryPoint;
    private final JwtAccessDeniedHandler accessDeniedHandler;

    public SecurityConfig(
            JwtAuthenticationFilter jwtAuthenticationFilter,
            JwtAuthenticationEntryPoint authenticationEntryPoint,
            JwtAccessDeniedHandler accessDeniedHandler) {

        this.jwtAuthenticationFilter = jwtAuthenticationFilter;
        this.authenticationEntryPoint = authenticationEntryPoint;
        this.accessDeniedHandler = accessDeniedHandler;
    }

    @Bean
    public SecurityFilterChain securityFilterChain(
            HttpSecurity http) throws Exception {

        http
                // REST API + JWT: CSRF disabled, no HTTP session
                .csrf(csrf -> csrf.disable())
                .cors(Customizer.withDefaults())
                .sessionManagement(session ->
                        session.sessionCreationPolicy(
                                SessionCreationPolicy.STATELESS
                        )
                )

                // Consistent 401 and 403 responses
                .exceptionHandling(exceptions -> exceptions
                        .authenticationEntryPoint(authenticationEntryPoint)
                        .accessDeniedHandler(accessDeniedHandler)
                )

                .authorizeHttpRequests(auth -> auth

                        // Allow internal error dispatches
                        .dispatcherTypeMatchers(
                                DispatcherType.ERROR
                        ).permitAll()

                        // CORS preflight requests
                        .requestMatchers(
                                HttpMethod.OPTIONS, "/**"
                        ).permitAll()

                        // Public login endpoint
                        .requestMatchers(
                                HttpMethod.POST, "/api/auth/login"
                        ).permitAll()

                        // Tenant selection token: allowed endpoints only
                        .requestMatchers(
                                HttpMethod.GET, "/api/auth/my-pharmacies"
                        ).hasAuthority("ROLE_TENANT_SELECTION")

                        .requestMatchers(
                                HttpMethod.POST, "/api/auth/select-tenant"
                        ).hasAuthority("ROLE_TENANT_SELECTION")

                        // Public pharmacy registration
                        .requestMatchers(
                                HttpMethod.POST, "/api/public/registration"
                        ).permitAll()

                        // Create a platform-level Super Admin account
                        .requestMatchers(
                                HttpMethod.POST, "/api/auth/platform-users"
                        ).hasRole("SUPER_ADMIN")

                        // Generic registration endpoint: Super Admin only
                        .requestMatchers(
                                HttpMethod.POST, "/api/auth"
                        ).hasRole("SUPER_ADMIN")

                        // Global user listing and status management
                        // Includes /api/auth/users/{id}/status
                        .requestMatchers(
                                "/api/auth/users",
                                "/api/auth/users/**"
                        ).hasRole("SUPER_ADMIN")

                        // Read/update/delete user by ID
                        // Examples: GET, PUT, DELETE /api/auth/{id}
                        .requestMatchers(
                                "/api/auth/*"
                        ).hasRole("SUPER_ADMIN")

                        // Pharmacy inventory APIs.
                        // TenantInventoryService and inventory services
                        // enforce tenant membership and role permissions.
                        .requestMatchers(
                                "/api/tenants/*/inventory/**"
                        ).authenticated()

                        // Tenant membership endpoints
                        // Service/controller must validate tenant membership
                        // and the specific membership role
                        .requestMatchers(
                                "/api/tenants/*/memberships",
                                "/api/tenants/*/memberships/**"
                        ).authenticated()

                        // Store endpoints
                        // StoreService must validate tenant membership and role
                        .requestMatchers(
                                "/api/tenants/*/stores",
                                "/api/tenants/*/stores/**"
                        ).authenticated()

                        // Read shared medicine catalogue
                        .requestMatchers(
                                HttpMethod.GET,
                                "/api/medicines",
                                "/api/medicines/**"
                        ).authenticated()

                        // Modify shared medicine catalogue: Super Admin only
                        .requestMatchers(
                                "/api/medicines",
                                "/api/medicines/**"
                        ).hasRole("SUPER_ADMIN")

                        // Tenant Purchase Orders: service validates membership and roles
                        .requestMatchers(
                                "/api/tenants/*/purchase-orders",
                                "/api/tenants/*/purchase-orders/**"
                        ).authenticated()

                        // Tenant Sales: SaleService validates tenant membership and role
                        .requestMatchers(
                                "/api/tenants/*/sales",
                                "/api/tenants/*/sales/**"
                        ).authenticated()

                        // Tenant supplier APIs: service validates tenant membership and role
                        .requestMatchers(
                                "/api/tenants/*/suppliers",
                                "/api/tenants/*/suppliers/**"
                        ).authenticated()

                        // Tenant GRN APIs: service validates tenant membership and role
                        .requestMatchers(
                                "/api/tenants/*/grn",
                                "/api/tenants/*/grn/**"
                        ).authenticated()

                        // Tenant administration: Super Admin only
                        .requestMatchers(
                                "/api/tenants",
                                "/api/tenants/**"
                        ).hasRole("SUPER_ADMIN")

                        // Super Admin module
                        .requestMatchers(
                                "/api/super-admin",
                                "/api/super-admin/**"
                        ).hasRole("SUPER_ADMIN")

                        // Everything else requires authentication
                        .anyRequest().authenticated()
                )

                // Disable unused authentication mechanisms
                .formLogin(form -> form.disable())
                .httpBasic(basic -> basic.disable())
                .logout(logout -> logout.disable())

                // Validate JWT before normal username/password auth
                .addFilterBefore(
                        jwtAuthenticationFilter,
                        UsernamePasswordAuthenticationFilter.class
                );

        return http.build();
    }

    @Bean
    public CorsConfigurationSource corsConfigurationSource() {

        CorsConfiguration configuration = new CorsConfiguration();

        configuration.setAllowedOrigins(
                List.of("http://localhost:4200")
        );

        configuration.setAllowedMethods(
                List.of(
                        "GET",
                        "POST",
                        "PUT",
                        "PATCH",
                        "DELETE",
                        "OPTIONS"
                )
        );

        configuration.setAllowedHeaders(
                List.of(
                        "Authorization",
                        "Content-Type",
                        "Accept"
                )
        );

        configuration.setExposedHeaders(
                List.of("Authorization")
        );

        configuration.setAllowCredentials(true);

        UrlBasedCorsConfigurationSource source =
                new UrlBasedCorsConfigurationSource();

        source.registerCorsConfiguration("/**", configuration);

        return source;
    }
}
